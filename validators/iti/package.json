{
  "name": "@signature-kit/iti",
  "version": "0.1.0",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./conformance": {
      "types": "./dist/conformance.d.ts",
      "import": "./dist/conformance.js"
    },
    "./remote": {
      "types": "./dist/remote.d.ts",
      "import": "./dist/remote.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit --tsBuildInfoFile .cache/typecheck.tsbuildinfo",
    "test": "vitest run"
  },
  "dependencies": {
    "@peculiar/asn1-ess": "2.8.0",
    "@peculiar/asn1-schema": "2.8.0",
    "@signature-kit/cms": "^0.2.1",
    "@signature-kit/http": "^0.1.0",
    "@signature-kit/pdf": "^0.3.0",
    "@signature-kit/signatures": "^0.1.0",
    "asn1js": "3.0.10",
    "effect": "4.0.0-beta.86",
    "pkijs": "3.4.0"
  },
  "devDependencies": {
    "@cantoo/pdf-lib": "2.7.1",
    "@signature-kit/a1": "^0.3.0"
  },
  "nx": {
    "targets": {
      "npm-pack": {
        "executor": "nx:run-commands",
        "options": {
          "command": "npm pack --dry-run --json",
          "cwd": "{projectRoot}"
        }
      },
      "npm-publish": {
        "executor": "nx:run-commands",
        "options": {
          "command": "npm publish --access public",
          "cwd": "{projectRoot}"
        }
      }
    }
  }
}
