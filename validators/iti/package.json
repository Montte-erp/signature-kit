{
  "name": "@signature-kit/iti",
  "version": "0.1.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Montte-erp/signature-kit.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./conformance": {
      "types": "./dist/conformance.d.ts",
      "import": "./dist/conformance.js"
    },
    "./remote": {
      "types": "./dist/remote.d.ts",
      "import": "./dist/remote.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run --root ../.. validators/iti/__tests__ --exclude '**/*.integration.test.*' --exclude '**/*.browser.test.*' --exclude '**/*.performance.test.*'"
  },
  "dependencies": {
    "@peculiar/asn1-ess": "2.11.0",
    "@peculiar/asn1-schema": "2.11.0",
    "@signature-kit/cms": "^0.2.1",
    "@signature-kit/http": "^0.1.0",
    "@signature-kit/pdf": "^0.3.0",
    "@signature-kit/signatures": "^0.1.0",
    "asn1js": "4.0.0",
    "effect": "4.0.5",
    "pkijs": "3.4.3"
  },
  "devDependencies": {
    "@cantoo/pdf-lib": "2.11.1",
    "@signature-kit/a1": "^0.3.0"
  },
  "nx": {
    "implicitDependencies": [
      "!@signature-kit/a1"
    ],
    "targets": {
      "test": {
        "dependsOn": [
          "build",
          {
            "projects": [
              "@signature-kit/a1"
            ],
            "target": "build"
          }
        ]
      },
      "npm-pack": {
        "executor": "nx:run-commands",
        "options": {
          "command": "bun pm pack --dry-run",
          "cwd": "{projectRoot}"
        }
      },
      "npm-publish": {
        "executor": "nx:run-commands",
        "options": {
          "command": "npm publish --access public",
          "cwd": "{projectRoot}"
        }
      }
    }
  }
}
