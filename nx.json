{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/**/__tests__/**/*",
      "!{projectRoot}/**/*.test.ts",
      "!{projectRoot}/**/*.test.tsx",
      "!{projectRoot}/**/*.spec.ts",
      "!{projectRoot}/**/*.spec.tsx",
      "!{projectRoot}/README.md",
      "!{projectRoot}/CHANGELOG.md"
    ],
    "sharedGlobals": [
      "{workspaceRoot}/bun.lock",
      "{workspaceRoot}/bunfig.toml",
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/tooling/typescript/base.json",
      "{workspaceRoot}/tooling/typescript/core.json",
      {
        "runtime": "bun --version"
      },
      {
        "runtime": "node --version"
      }
    ]
  },
  "targetDefaults": {
    "build": {
      "inputs": [
        "...",
        {
          "runtime": "node --version"
        }
      ]
    },
    "typecheck": {
      "inputs": [
        "...",
        {
          "runtime": "node --version"
        }
      ]
    },
    "test": {
      "cache": true,
      "dependsOn": ["build"],
      "inputs": ["default", "^production"]
    },
    "npm-pack": {
      "dependsOn": ["build"],
      "cache": false
    },
    "npm-publish": {
      "dependsOn": ["build", "^npm-publish"],
      "cache": false
    }
  },
  "plugins": [
    {
      "plugin": "@nx/js/typescript",
      "include": [
        "core/**/tsconfig.json",
        "formats/**/tsconfig.json",
        "shared/**/tsconfig.json",
        "signers/**/tsconfig.json",
        "validators/**/tsconfig.json"
      ],
      "options": {
        "compiler": "tsc",
        "typecheck": {
          "targetName": "typecheck",
          "configName": "tsconfig.json"
        },
        "build": {
          "targetName": "build",
          "configName": "tsconfig.json",
          "buildDepsName": "build-deps",
          "watchDepsName": "watch-deps"
        }
      }
    }
  ],
  "pluginsConfig": {
    "@nx/js": {
      "analyzeSourceFiles": false,
      "projectsAffectedByDependencyUpdates": "auto"
    }
  },
  "analytics": false
}
