{
  "name": "@signature-kit/docs",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "paraglide": "paraglide-js compile --project ./project.inlang --outdir ./paraglide --strategy baseLocale",
    "dev": "bun run paraglide && bun run registry:build && bun run clean:generated-comments && waku dev --host 0.0.0.0 --port ${PORT:-3001}",
    "registry:build": "bun run scripts/build-registry.ts",
    "clean:generated-comments": "bun run scripts/clean-generated-comments.ts",
    "build": "bun run paraglide && bun run registry:build && bun run clean:generated-comments && waku build",
    "start": "waku start --host 0.0.0.0 --port ${PORT:-3001}",
    "postinstall": "fumadocs-mdx && bun run clean:generated-comments && paraglide-js compile --project ./project.inlang --outdir ./paraglide --strategy baseLocale",
    "types:check": "fumadocs-mdx && bun run clean:generated-comments && bun run paraglide && bun run registry:build && tsc -p tsconfig.json --noEmit",
    "build:foldkit": "bun run paraglide && bun run registry:build && bun run clean:generated-comments && bun run scripts/build-content-site.ts"
  },
  "dependencies": {
    "@effect/platform-browser": "4.0.5",
    "@effect/platform-node": "4.0.5",
    "@foldkit/node": "0.1.0",
    "@fontsource-variable/caveat": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fumapress/feedback": "1.1.5",
    "@fumapress/tegami": "1.1.4",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-slot": "^1.5.0",
    "@react-pdf/renderer": "4.9.0",
    "@signature-kit/a1": "^0.3.0",
    "@signature-kit/cms": "^0.2.1",
    "@signature-kit/i18n": "^0.1.0",
    "@signature-kit/pdf": "^0.3.0",
    "@signature-kit/react": "^0.1.0",
    "@signature-kit/signatures": "^0.1.0",
    "@tanstack/react-form": "1.33.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "effect": "4.0.5",
    "foldkit": "0.169.0",
    "fumadocs-core": "^16.17.7",
    "fumadocs-mdx": "15.4.9",
    "fumadocs-ui": "^16.17.7",
    "fumapress": "1.6.2",
    "hast-util-to-html": "9.0.5",
    "hast-util-to-string": "3.0.1",
    "lucide-react": "^1.61.0",
    "mdast-util-to-hast": "13.2.1",
    "mdast-util-to-markdown": "2.1.2",
    "mermaid": "^12.2.0",
    "motion": "^14.5.0",
    "pdfjs-dist": "6.3.289",
    "posthog-js": "^1.438.13",
    "posthog-node": "^5.56.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-pdf": "11.0.0",
    "react-server-dom-webpack": "19.3.1",
    "rehype-slug": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-mdx": "3.1.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "shiki": "4.5.0",
    "tailwind-merge": "^3.7.0",
    "takumi-js": "2.17.1",
    "unified": "11.0.5",
    "unist-util-visit": "5.2.0",
    "waku": "1.0.0-rc.3",
    "xast-util-to-xml": "4.0.0",
    "xastscript": "4.0.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@cantoo/pdf-lib": "2.11.1",
    "@foldkit/vite-plugin": "0.28.0",
    "@hono/node-server": "2.1.5",
    "@inlang/paraglide-js": "2.29.1",
    "@signature-kit/certificates": "^0.2.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/xast": "2.0.4",
    "mdast-util-mdx-jsx": "3.2.0",
    "parse5": "8.0.1",
    "sirv": "3.0.2",
    "tailwindcss": "^4.3.3",
    "vite": "8.3.5",
    "xast-util-from-xml": "4.0.0"
  },
  "nx": {
    "targets": {
      "build": {
        "cache": true,
        "dependsOn": [
          "^build"
        ],
        "inputs": [
          "production",
          "^production"
        ],
        "outputs": [
          "{projectRoot}/dist",
          "{projectRoot}/.source",
          "{projectRoot}/paraglide",
          "{projectRoot}/public/r"
        ]
      },
      "types:check": {
        "cache": true,
        "dependsOn": [
          "^build"
        ],
        "inputs": [
          "default",
          "^production"
        ],
        "outputs": [
          "{projectRoot}/.cache/typecheck.tsbuildinfo",
          "{projectRoot}/.source",
          "{projectRoot}/paraglide",
          "{projectRoot}/public/r"
        ]
      }
    }
  }
}
