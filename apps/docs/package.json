{
  "name": "@signature-kit/docs",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "paraglide": "paraglide-js compile --project ./project.inlang --outdir ./paraglide --strategy baseLocale",
    "dev": "bun run paraglide && bun run registry:build && bun run clean:generated-comments && waku dev --host 0.0.0.0 --port ${PORT:-3001}",
    "registry:build": "bun run scripts/build-registry.ts",
    "clean:generated-comments": "bun run scripts/clean-generated-comments.ts",
    "build": "bun run paraglide && bun run registry:build && bun run clean:generated-comments && waku build",
    "start": "waku start --host 0.0.0.0 --port ${PORT:-3001}",
    "postinstall": "fumadocs-mdx && bun run clean:generated-comments && paraglide-js compile --project ./project.inlang --outdir ./paraglide --strategy baseLocale",
    "types:check": "fumadocs-mdx && bun run clean:generated-comments && bun run paraglide && bun run registry:build && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/caveat": "5.2.8",
    "@fontsource-variable/geist-mono": "5.2.8",
    "@fontsource-variable/inter": "5.2.8",
    "@fumapress/feedback": "0.7.3",
    "@fumapress/tegami": "0.7.3",
    "@radix-ui/react-checkbox": "^1.3.7",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-label": "^2.1.11",
    "@radix-ui/react-slot": "^1.3.0",
    "@react-pdf/renderer": "4.5.1",
    "@signature-kit/a1": "^0.3.0",
    "@signature-kit/cms": "^0.2.1",
    "@signature-kit/i18n": "^0.1.0",
    "@signature-kit/pdf": "^0.3.0",
    "@signature-kit/react": "^0.1.0",
    "@signature-kit/signatures": "^0.1.0",
    "@tanstack/react-form": "1.33.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "effect": "4.0.0-beta.86",
    "fumadocs-core": "^16.11.4",
    "fumadocs-mdx": "15.1.0",
    "fumadocs-ui": "^16.11.4",
    "fumapress": "0.7.3",
    "lucide-react": "^1.24.0",
    "mermaid": "^11.16.0",
    "motion": "^12.42.2",
    "posthog-js": "^1.399.2",
    "posthog-node": "^5.41.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-pdf": "10.4.1",
    "react-server-dom-webpack": "19.2.7",
    "tailwind-merge": "^3.6.0",
    "takumi-js": "2.1.2",
    "waku": "1.0.0-beta.6"
  },
  "devDependencies": {
    "@cantoo/pdf-lib": "2.7.1",
    "@inlang/paraglide-js": "2.20.2",
    "@tailwindcss/vite": "4.3.2",
    "@types/mdx": "^2.0.14",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "tailwindcss": "^4.3.2",
    "vite": "8.1.3"
  },
  "nx": {
    "targets": {
      "build": {
        "cache": true,
        "dependsOn": [
          "^build"
        ],
        "inputs": [
          "production",
          "^production"
        ],
        "outputs": [
          "{projectRoot}/dist",
          "{projectRoot}/.source",
          "{projectRoot}/paraglide",
          "{projectRoot}/public/r"
        ]
      },
      "types:check": {
        "cache": true,
        "dependsOn": [
          "^build"
        ],
        "inputs": [
          "default",
          "^production"
        ],
        "outputs": [
          "{projectRoot}/.cache/typecheck.tsbuildinfo",
          "{projectRoot}/.source",
          "{projectRoot}/paraglide",
          "{projectRoot}/public/r"
        ]
      }
    }
  }
}
