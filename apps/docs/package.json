{
  "name": "@signature-kit/docs",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "bun run registry:build && vite --config foldkit.vite.config.ts --host 0.0.0.0 --port ${PORT:-3001} --strictPort",
    "registry:build": "bun run scripts/build-registry.ts",
    "build": "bun run registry:build && vite build --config foldkit.vite.config.ts",
    "start": "bun foldkit/host.mjs",
    "types:check": "bun run registry:build && tsc -p tsconfig.json --noEmit",
    "foldkit:dev": "bun run dev",
    "foldkit:build": "bun run build",
    "foldkit:start": "bun run start",
    "foldkit:test": "vitest run foldkit --exclude '**/*.browser.test.*'"
  },
  "dependencies": {
    "@alchemy.run/domain": "2.0.0-beta.85",
    "@effect/platform-browser": "4.1.0",
    "@foldkit/ui": "0.170.0",
    "@fontsource-variable/caveat": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-slot": "^1.5.0",
    "@react-pdf/renderer": "4.9.0",
    "@signature-kit/a1": "^0.4.0",
    "@signature-kit/cms": "^0.2.1",
    "@signature-kit/i18n": "^0.1.0",
    "@signature-kit/pdf": "^0.4.0",
    "@signature-kit/react": "^0.1.0",
    "@signature-kit/signatures": "^0.2.0",
    "@signature-kit/signing-domain": "0.0.1",
    "@tanstack/react-form": "1.33.5",
    "@xmldom/xmldom": "^0.9.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "effect": "4.1.0",
    "foldkit": "0.170.0",
    "github-slugger": "2.0.0",
    "lucide-react": "^1.61.0",
    "mdast-util-to-string": "4.0.0",
    "mermaid": "^12.2.0",
    "posthog-js": "^1.438.13",
    "posthog-node": "^5.56.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-pdf": "11.0.0",
    "remark-gfm": "4.0.1",
    "remark-mdx": "3.1.1",
    "remark-parse": "11.0.0",
    "tailwind-merge": "^3.7.0",
    "takumi-js": "2.17.1",
    "unified": "11.0.5",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@cantoo/pdf-lib": "2.11.1",
    "@foldkit/vite-plugin": "0.29.0",
    "@hono/node-server": "2.1.5",
    "@napi-rs/canvas": "1.0.13",
    "@tailwindcss/vite": "4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "vite": "8.3.5"
  },
  "nx": {
    "targets": {
      "build": {
        "cache": true,
        "dependsOn": [
          "^build"
        ],
        "inputs": [
          "production",
          "^production"
        ],
        "outputs": [
          "{projectRoot}/dist-foldkit/client",
          "{projectRoot}/dist-foldkit/server",
          "{projectRoot}/public/r"
        ]
      },
      "types:check": {
        "cache": true,
        "dependsOn": [
          "^build"
        ],
        "inputs": [
          "default",
          "^production"
        ],
        "outputs": [
          "{projectRoot}/.cache/typecheck.tsbuildinfo",
          "{projectRoot}/public/r"
        ]
      }
    }
  }
}
