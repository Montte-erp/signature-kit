{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "types": ["bun"],
    "allowJs": true,
    "checkJs": false,
    "esModuleInterop": true,
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "incremental": true,
    "isolatedDeclarations": false,
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "emitDeclarationOnly": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "tsBuildInfoFile": "${configDir}/.cache/tsbuildinfo.json",
    "verbatimModuleSyntax": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": "../..",
    "paths": {
      "@signature-kit/a1/config": ["signers/a1/src/config.ts"],
      "@signature-kit/a1/signer": ["signers/a1/src/signer.ts"],
      "@signature-kit/asn1": ["shared/asn1/src/asn1.ts"],
      "@signature-kit/assinafy": ["signers/assinafy/src/index.ts"],
      "@signature-kit/certificates": ["core/certificates/src/index.ts"],
      "@signature-kit/clicksign": ["signers/clicksign/src/index.ts"],
      "@signature-kit/docuseal": ["signers/docuseal/src/index.ts"],
      "@signature-kit/documenso": ["signers/documenso/src/index.ts"],
      "@signature-kit/cms/config": ["shared/cms/src/config.ts"],
      "@signature-kit/cms/icp-brasil": ["shared/cms/src/icp-brasil.ts"],
      "@signature-kit/cms/sign": ["shared/cms/src/sign.ts"],
      "@signature-kit/cms/verify": ["shared/cms/src/verify.ts"],
      "@signature-kit/cms/inspect": ["shared/cms/src/inspect.ts"],
      "@signature-kit/http": ["core/http/src/http.ts"],
      "@signature-kit/signatures": ["core/signatures/src/signatures.ts"],
      "@signature-kit/i18n": ["core/i18n/src/i18n.ts"],
      "@signature-kit/crypto/base64": ["shared/crypto/src/base64.ts"],
      "@signature-kit/crypto/config": ["shared/crypto/src/config.ts"],
      "@signature-kit/crypto/pem": ["shared/crypto/src/pem.ts"],
      "@signature-kit/crypto/pkcs12": ["shared/crypto/src/pkcs12.ts"],
      "@signature-kit/zapsign": ["signers/zapsign/src/index.ts"],
      "@signature-kit/pdf/config": ["formats/pdf/src/config.ts"],
      "@signature-kit/pdf/builder": ["formats/pdf/src/builder.ts"],
      "@signature-kit/pdf/builder-store": ["formats/pdf/src/builder-store.ts"],
      "@signature-kit/pdf/workflow": ["formats/pdf/src/workflow.ts"],
      "@signature-kit/pdf/sign": ["formats/pdf/src/sign.ts"],
      "@signature-kit/pdf/stamp": ["formats/pdf/src/stamp.ts"],
      "@signature-kit/pdf/anchors": ["formats/pdf/src/anchors.ts"],
      "@signature-kit/pdf/liteparse-browser": ["formats/pdf/src/liteparse-browser.ts"],
      "@signature-kit/pdf/merge": ["formats/pdf/src/merge.ts"],
      "@signature-kit/pdf/verify": ["formats/pdf/src/verify.ts"],
      "@signature-kit/pdf/byte-range": ["formats/pdf/src/byte-range.ts"],
      "@signature-kit/react/a1": ["formats/react/src/a1.ts"],
      "@signature-kit/react/config": ["formats/react/src/config.ts"],
      "@signature-kit/react/builder": ["formats/react/src/builder.ts"],
      "@signature-kit/react/browser-pdf": ["formats/react/src/browser-pdf.ts"],
      "@signature-kit/iti/conformance": ["validators/iti/src/conformance.ts"],
      "@signature-kit/iti/remote": ["validators/iti/src/remote.ts"],
      "@signature-kit/xml/config": ["formats/xml/src/config.ts"],
      "@signature-kit/xml/sign": ["formats/xml/src/sign.ts"],
      "@signature-kit/xml/verify": ["formats/xml/src/verify.ts"],
      "@signature-kit/xml/runtime": ["formats/xml/src/runtime.ts"]
    }
  },
  "display": "Default"
}
