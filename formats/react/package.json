{
  "name": "@signature-kit/react",
  "version": "0.1.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Licitei/signature-kit.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./a1": {
      "types": "./dist/a1.d.ts",
      "import": "./dist/a1.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    },
    "./sync-store": {
      "types": "./dist/sync-store.d.ts",
      "import": "./dist/sync-store.js"
    },
    "./browser-pdf": {
      "types": "./dist/browser-pdf.d.ts",
      "import": "./dist/browser-pdf.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run --root ../.. --exclude '**/*.browser.test.*' --exclude '**/*.integration.test.*' --exclude '**/*.performance.test.*' formats/react/__tests__",
    "test:browser": "vitest run --root ../.. --config tooling/vitest/browser.config.ts formats/react/__tests__"
  },
  "dependencies": {
    "@effect/platform-browser": "4.1.0",
    "@signature-kit/a1": "^0.4.0",
    "@signature-kit/cms": "^0.2.1",
    "@signature-kit/pdf": "^0.4.0",
    "@signature-kit/signatures": "^0.2.0",
    "effect": "4.1.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "peerDependencies": {
    "react": ">=18.3.0 || >=19.0.0"
  },
  "nx": {
    "targets": {
      "npm-pack": {
        "executor": "nx:run-commands",
        "options": {
          "command": "bun pm pack --dry-run",
          "cwd": "{projectRoot}"
        }
      },
      "npm-publish": {
        "executor": "nx:run-commands",
        "options": {
          "command": "npm publish --access public",
          "cwd": "{projectRoot}"
        }
      }
    }
  }
}
