{
  "name": "@signature-kit/pdf",
  "version": "0.3.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Montte-erp/signature-kit.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    },
    "./builder": {
      "types": "./dist/builder.d.ts",
      "import": "./dist/builder.js"
    },
    "./builder-store": {
      "types": "./dist/builder-store.d.ts",
      "import": "./dist/builder-store.js"
    },
    "./workflow": {
      "types": "./dist/workflow.d.ts",
      "import": "./dist/workflow.js"
    },
    "./sign": {
      "types": "./dist/sign.d.ts",
      "import": "./dist/sign.js"
    },
    "./stamp": {
      "types": "./dist/stamp.d.ts",
      "import": "./dist/stamp.js"
    },
    "./anchors": {
      "types": "./dist/anchors.d.ts",
      "import": "./dist/anchors.js"
    },
    "./merge": {
      "types": "./dist/merge.d.ts",
      "import": "./dist/merge.js"
    },
    "./liteparse-browser": {
      "types": "./dist/liteparse-browser.d.ts",
      "import": "./dist/liteparse-browser.js"
    },
    "./verify": {
      "types": "./dist/verify.d.ts",
      "import": "./dist/verify.js"
    },
    "./byte-range": {
      "types": "./dist/byte-range.d.ts",
      "import": "./dist/byte-range.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run --root ../.. formats/pdf/__tests__ --exclude '**/*.browser.test.*' --exclude '**/*.performance.test.*'"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "2.7.2",
    "@llamaindex/liteparse-wasm": "^2.5.1",
    "@signature-kit/cms": "^0.2.1",
    "@signature-kit/i18n": "^0.1.0",
    "@signature-kit/signatures": "^0.1.0",
    "effect": "4.0.0-beta.86",
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "@signature-kit/a1": "^0.3.0"
  },
  "nx": {
    "implicitDependencies": [
      "!@signature-kit/a1"
    ],
    "targets": {
      "test": {
        "dependsOn": [
          "build",
          {
            "projects": [
              "@signature-kit/a1"
            ],
            "target": "build"
          }
        ]
      },
      "npm-pack": {
        "executor": "nx:run-commands",
        "options": {
          "command": "bun pm pack --dry-run",
          "cwd": "{projectRoot}"
        }
      },
      "npm-publish": {
        "executor": "nx:run-commands",
        "options": {
          "command": "npm publish --access public",
          "cwd": "{projectRoot}"
        }
      }
    }
  }
}
